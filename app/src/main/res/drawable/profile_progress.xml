<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
                <shape android:shape="rectangle" android:tint="#92E54D">
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:state_selected="false" android:top="5dp">
        <layer-list>
            <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
                <shape android:shape="rectangle" android:tint="#E0EAEB">
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>